# Template only. Do not commit real credentials or use this file as a production env file.
# The isolated deployment must provide fictional-data-only services for every value.
APP_ENV=android-test
PUBLIC_APP_ORIGIN=https://eho-test.lefeast.co.uk
AUTH_ALLOWED_ORIGINS=https://eho-test.lefeast.co.uk
DATABASE_URL=REPLACE_WITH_ISOLATED_NEON_TEST_CONNECTION
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_ISOLATED_TEST_STORAGE_TOKEN
AUTH_SESSION_SECRET=REPLACE_WITH_TEST_ONLY_SECRET
VITE_OFFLINE_OPENING_CHECKLIST=true
VITE_OFFLINE_CLOSING_CHECKLIST=true
VITE_OFFLINE_CLEANING=true
VITE_OFFLINE_SECURITY=true
VITE_OFFLINE_ADDITIONAL=true
VITE_OFFLINE_HANDOVER=true
# Keep higher-risk workflows disabled until separately accepted on the tablet.
VITE_OFFLINE_TEMPERATURE=false
VITE_OFFLINE_PROBE=false
VITE_OFFLINE_ISSUES=false
VITE_OFFLINE_WASTAGE=false
