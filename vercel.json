{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/catalogue-sync", "schedule": "0 * * * *" },
    { "path": "/api/cron/wastage-sync", "schedule": "0 * * * *" }
  ]
}
