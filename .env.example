# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# New Vercel backend (server-only; never prefix with VITE_)
DATABASE_URL=

# Server-only private Vercel Blob/document storage
BLOB_READ_WRITE_TOKEN=

# Server-only Le Feast authentication configuration
RESEND_API_KEY=
AUTH_FROM_EMAIL=
AUTH_OTP_PEPPER=
AUTH_SESSION_SECRET=
AUTH_ALLOWED_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=

# Server-only Google Sheets service-account configuration
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Wastage
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
